HOST=127.0.0.1
PORT=3150
DATABASE_PATH=./local-data/quickview.sqlite
NODE_ENV=development
# Set the new service's HTTPS origin in Railway.
# APP_ORIGIN=https://your-quickview.up.railway.app
QUICKVIEW_AI_MODE=guided
# Optional: set QUICKVIEW_AI_MODE=openai and a new OPENAI_API_KEY in Railway.
# Questions/context only are sent to the model to draft requests. Responses stay local.
# OPENAI_API_KEY=
# OPENAI_MODEL=your-structured-output-capable-model
